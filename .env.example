# =============================================================
# Healthcare Agentic AI — Production Grade (demo)
# Copy to .env and fill in. NEVER commit .env.
# =============================================================

# ----- LLM (provider-agnostic) -----
# LLM_PROVIDER: sandbox | groq | gemini | anthropic
#   sandbox = deterministic local echo model (no network, used for tests/CI)
LLM_PROVIDER=sandbox

# Groq (default real provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.0

# ----- Integrations -----
# EHR read: sandbox | fhir_public   (fhir_public = one real public FHIR test server)
EHR_MODE=sandbox
FHIR_PUBLIC_BASE_URL=https://hapi.fhir.org/baseR4

# ----- Application -----
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true = JSON logs (prod), false = console (dev)

# ----- Billing policy (provider-configurable) -----
# Default self-pay / prompt-pay discount for uninsured patients (0.0 = none).
# A per-encounter self_pay_discount_pct in the request overrides this.
SELF_PAY_DISCOUNT_PCT=0.0
